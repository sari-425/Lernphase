# ============================================================
# Betriebsrat Direkt – Konfiguration (Vorlage)
# Kopieren nach .env und ausfüllen. Die Datei .env NIE in Git einchecken.
# Geheimnisse erzeugen:  npm run secrets
# ============================================================

# --- Datenbank ---
# Lokal ohne Installation (eingebettet, nur 1 Prozess): weglassen oder pglite://.data/pglite
# Lokal mit PostgreSQL (z. B. Postgres.app auf dem Mac):
# DATABASE_URL=postgres://IHR_MAC_BENUTZER@localhost:5432/betriebsrat
# Docker-Compose setzt DATABASE_URL selbst; dort nur POSTGRES_PASSWORD angeben:
POSTGRES_PASSWORD=

# --- Öffentliche Adresse (ohne Schrägstrich am Ende) ---
APP_URL=http://localhost:3000
# Nur für docker-compose (Caddy/HTTPS):
DOMAIN=betriebsrat.example.org

# --- Geheimnisse (npm run secrets) ---
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für Push-Dienste (Pflicht laut Standard), z. B. mailto:it@ihr-betriebsrat.de
VAPID_SUBJECT=mailto:betrieb@example.org

# Einrichtung neuer Betriebsräte über /einrichtung (nach der Einrichtung wieder leeren!)
SETUP_TOKEN=

# Optional: Startseite leitet direkt auf diesen Betriebsrat weiter
# DEFAULT_TENANT_SLUG=gruener-systemtechnik

# --- Planer ---
# true: interner Planer (für Server mit dauerhaft laufendem Prozess, z. B. Docker)
ENABLE_INTERNAL_SCHEDULER=true
# Nur für Serverless-Hosting: /api/cron regelmäßig mit "Authorization: Bearer <CRON_SECRET>" aufrufen
CRON_SECRET=

# --- Push-Begrenzung je Betriebsrat ---
PUSH_MAX_PER_TENANT_PER_DAY=10
PUSH_MIN_INTERVAL_MINUTES=5

# --- Sonstiges ---
# Hinter Reverse Proxy (Caddy/Nginx): true
TRUST_PROXY=false
# Lokal über http://localhost ohne HTTPS: false (in Produktion immer true/leer lassen)
# COOKIE_SECURE=false
# Datenbankschema beim Start automatisch aktualisieren
AUTO_MIGRATE=true
